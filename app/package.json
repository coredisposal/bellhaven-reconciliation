{
  "name": "bellhaven-review-desk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "test:e2e": "node --import ./scripts/sites-env.mjs --test tests/e2e/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "miniflare": "4.20260515.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "baseline-browser-mapping": "2.11.0",
    "fast-uri": "3.1.8",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5",
    "browserslist": "4.28.7",
    "image-size": "2.0.3",
    "js-yaml": "4.3.2",
    "fflate": "0.7.5",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "ws": "8.21.0",
    "undici": "7.29.1",
    "esbuild@0.28": "0.28.1"
  }
}
